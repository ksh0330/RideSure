# Copy this file to .env. Never commit the resulting .env file.

# Neo4j local development settings (password has no source-code default)
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASS=your_neo4j_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Local EXAONE explanation server
MODEL_ID=LGAI-EXAONE/EXAONE-4.0-1.2B
HF_HOME=.cache/huggingface
# Explicit ordinary-file snapshot avoids Windows symlink/admin requirements.
MODEL_PATH=.cache/huggingface/ridesure-exaone
HF_HUB_DISABLE_SYMLINKS_WARNING=1
# Set to 1 only after the model has been downloaded once.
HF_HUB_OFFLINE=0
LLM_BASE_URL=http://127.0.0.1:8001
MAX_NEW_TOKENS=160

# Application processes
TARGET_DATE=2025-11-08
APP_HOST=127.0.0.1
APP_PORT=8000
LLM_HOST=127.0.0.1
LLM_PORT=8001

# Kakao Maps JavaScript SDK. This key is visible in the browser; restrict domains.
KAKAO_MAP_JAVASCRIPT_KEY=your_kakao_javascript_key
